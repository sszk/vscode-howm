{
  "name": "markdown-howm",
  "displayName": "Markdown howm",
  "description": "Write small Markdown notes, find them through search and come-from links, and manage reminders.",
  "version": "0.5.3",
  "publisher": "local-howm",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test test/*.test.cjs",
    "package": "npm run compile && vsce package --allow-missing-repository",
    "test:integration": "npm run compile && node scripts/integration.cjs",
    "test:view-registration": "npm run compile && node scripts/integration.cjs --missing-view",
    "test:import": "perl -c scripts/import-markdown.pl && prove test/import-markdown.t && npm run compile && node --test test/import-markdown.cjs",
    "test:windows-paths": "npm run compile && node scripts/integration.cjs --windows-paths"
  },
  "contributes": {
    "colors": [
      {
        "id": "howm.todoDueSoonForeground",
        "description": "Todoと予定ビューで期日が近い締切の文字色。",
        "defaults": {
          "dark": "#FFA500",
          "light": "#AD5F00",
          "highContrast": "#FFA500",
          "highContrastLight": "#AD5F00"
        }
      },
      {
        "id": "howm.todoOverdueForeground",
        "description": "Todoと予定ビューで期日を過ぎた締切の文字色。",
        "defaults": {
          "dark": "#FF6666",
          "light": "#C62828",
          "highContrast": "#FF6666",
          "highContrastLight": "#C62828"
        }
      },
      {
        "id": "howm.scheduleTodayForeground",
        "description": "Todoと予定ビューで当日の予定の文字色。",
        "defaults": {
          "dark": "#FFD700",
          "light": "#806C00",
          "highContrast": "#FFD700",
          "highContrastLight": "#806C00"
        }
      }
    ],
    "commands": [
      {
        "command": "howm.home",
        "title": "howm: ホーム"
      },
      {
        "command": "howm.create",
        "title": "howm: 新しいメモ",
        "icon": "$(new-file)"
      },
      {
        "command": "howm.capture",
        "title": "howm: 速記"
      },
      {
        "command": "howm.search",
        "title": "howm: 全文検索",
        "icon": "$(search)"
      },
      {
        "command": "howm.searchRegex",
        "title": "howm: 正規表現検索"
      },
      {
        "command": "howm.list",
        "title": "howm: メモ一覧"
      },
      {
        "command": "howm.recent",
        "title": "howm: 最近のメモ"
      },
      {
        "command": "howm.follow",
        "title": "howm: カーソル位置のリンクを開く"
      },
      {
        "command": "howm.related",
        "title": "howm: 関連メモ"
      },
      {
        "command": "howm.concatenate",
        "title": "howm: 検索結果を連結表示"
      },
      {
        "command": "howm.reminders",
        "title": "howm: Todoと予定"
      },
      {
        "command": "howm.complete",
        "title": "howm: この行のリマインダを完了"
      },
      {
        "command": "howm.changeDate",
        "title": "howm: この行の日付を変更"
      },
      {
        "command": "howm.insertDate",
        "title": "howm: 今日の日付を挿入"
      },
      {
        "command": "howm.insertKeyword",
        "title": "howm: キーワードを挿入"
      },
      {
        "command": "howm.history",
        "title": "howm: 検索履歴"
      },
      {
        "command": "howm.random",
        "title": "howm: ランダムなメモ"
      },
      {
        "command": "howm.refresh",
        "title": "howm: 索引を再構築",
        "icon": "$(refresh)"
      },
      {
        "command": "howm.configure",
        "title": "howm: メモの保存先を選択",
        "icon": "$(folder-opened)"
      },
      {
        "command": "howm.showTodos",
        "title": "howm: Todoサイドバーを開く"
      },
      {
        "command": "howm.completeReminder",
        "title": "howm: リマインダを完了",
        "icon": "$(check)"
      },
      {
        "command": "howm.focusNotesSearch",
        "title": "howm: メモ一覧で検索",
        "icon": "$(search)"
      },
      {
        "command": "howm.refreshOnThisDay",
        "title": "howm: 過去の今日を更新",
        "icon": "$(refresh)"
      },
      {
        "command": "howm.refreshSimilarNotes",
        "title": "howm: 類似メモを更新",
        "icon": "$(refresh)"
      }
    ],
    "keybindings": [
      {
        "command": "howm.create",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "howm.search",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h"
      }
    ],
    "views": {
      "howm": [
        {
          "id": "howm.calendar",
          "name": "カレンダー",
          "type": "webview"
        },
        {
          "id": "howm.todos",
          "name": "Todoと予定"
        },
        {
          "id": "howm.notes",
          "name": "メモ一覧",
          "type": "webview"
        },
        {
          "id": "howm.onThisDay",
          "name": "過去の今日",
          "visibility": "collapsed"
        },
        {
          "id": "howm.similarNotes",
          "name": "類似メモ",
          "visibility": "collapsed"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "howm.create",
          "when": "view == howm.notes || view == howm.calendar",
          "group": "navigation@1"
        },
        {
          "command": "howm.focusNotesSearch",
          "when": "view == howm.notes",
          "group": "navigation@2"
        },
        {
          "command": "howm.refresh",
          "when": "view == howm.notes",
          "group": "navigation@3"
        },
        {
          "command": "howm.refresh",
          "when": "view == howm.todos",
          "group": "navigation@1"
        },
        {
          "command": "howm.configure",
          "when": "view == howm.todos",
          "group": "navigation@2"
        },
        {
          "command": "howm.refreshOnThisDay",
          "when": "view == howm.onThisDay",
          "group": "navigation@1"
        },
        {
          "command": "howm.refreshSimilarNotes",
          "when": "view == howm.similarNotes",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "howm.completeReminder",
          "when": "view == howm.todos && viewItem == howm.reminder",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "howm.completeReminder",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Markdown howm",
      "properties": {
        "howm.notesDirectory": {
          "type": "string",
          "default": "",
          "description": "メモの保存先。空欄はワークスペース内のhowm。絶対パス、~/、ワークスペース相対パスに対応。"
        },
        "howm.filenamePattern": {
          "type": "string",
          "default": "{YYYY}/{MM}/{YYYY}-{MM}-{DD}-{HH}{mm}{ss}.md",
          "description": "新規メモのファイル名。重複時は連番を追加。"
        },
        "howm.defaultTitle": {
          "type": "string",
          "default": "メモ",
          "description": "新しいメモのタイトルの初期値。選択中のテキストがある場合はそちらを優先します。空文字列にすると初期値を空欄にできます。"
        },
        "howm.template": {
          "type": "string",
          "default": "# {title}\n\n[{date} {time}]\n\n{body}\n",
          "description": "新規メモ。{title}, {date}, {time}, {body}を使用可能。"
        },
        "howm.maxFileSizeKB": {
          "type": "number",
          "default": 1024,
          "minimum": 1,
          "description": "索引に含めるMarkdownファイルの最大サイズ(KB)。"
        },
        "howm.calendarWeekStart": {
          "type": "string",
          "enum": [
            "sunday",
            "monday"
          ],
          "enumDescriptions": [
            "日曜始まり（日・月・火・水・木・金・土）",
            "月曜始まり（月・火・水・木・金・土・日）"
          ],
          "default": "sunday",
          "description": "カレンダーの週の開始日。変更すると表示中のカレンダーにも即座に反映します。"
        },
        "howm.todos.dueSoonDays": {
          "type": "integer",
          "default": 3,
          "minimum": 0,
          "description": "Todoと予定ビューで締切（!）を期日が近い色にする日数。期日の何日前から色を付けるかを指定します。0は当日のみ。期日翌日から期限超過の色になります。色はworkbench.colorCustomizationsのhowm.todoDueSoonForeground・howm.todoOverdueForeground・howm.scheduleTodayForegroundで変更できます。"
        },
        "howm.onThisDay.enabled": {
          "type": "boolean",
          "default": true,
          "description": "過去の今日のメモを年別に表示します。"
        },
        "howm.similarNotes.enabled": {
          "type": "boolean",
          "default": true,
          "description": "現在のメモに内容が近いメモを表示します。"
        },
        "howm.similarNotes.maxResults": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "description": "類似メモの最大表示件数。"
        },
        "howm.similarNotes.minSimilarity": {
          "type": "number",
          "default": 0.1,
          "minimum": 0,
          "maximum": 1,
          "description": "表示する類似メモの最低類似度（0〜1）。"
        },
        "howm.similarNotes.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "メモの切り替えや編集時に類似メモを自動更新します。"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "howm",
          "title": "howm",
          "icon": "resources/howm.svg"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.0"
  }
}
