{
  "name": "markdown-howm",
  "displayName": "%howm.displayName%",
  "description": "%howm.description%",
  "version": "0.5.24",
  "publisher": "local-howm",
  "repository": {
    "type": "git",
    "url": "https://github.com/sszk/vscode-howm.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && npm run l10n:check && node --test test/*.test.cjs",
    "package": "npm run compile && npm run l10n:check && vsce package --dependencies --allow-missing-repository",
    "test:integration": "npm run compile && node scripts/integration.cjs",
    "test:url-paste": "npm run compile && node scripts/integration.cjs --url-paste",
    "test:view-registration": "npm run compile && node scripts/integration.cjs --missing-view",
    "test:import": "perl -c scripts/import-markdown.pl && prove test/import-markdown.t && npm run compile && node --test test/import-markdown.cjs",
    "test:windows-paths": "npm run compile && node scripts/integration.cjs --windows-paths",
    "l10n:extract": "vscode-l10n-dev export --outDir ./l10n ./src",
    "l10n:check": "node scripts/check-l10n.cjs"
  },
  "contributes": {
    "colors": [
      {
        "id": "howm.todoDueSoonForeground",
        "description": "%howm.todoDueSoonForeground.description%",
        "defaults": {
          "dark": "#FFA500",
          "light": "#AD5F00",
          "highContrast": "#FFA500",
          "highContrastLight": "#AD5F00"
        }
      },
      {
        "id": "howm.todoOverdueForeground",
        "description": "%howm.todoOverdueForeground.description%",
        "defaults": {
          "dark": "#FF6666",
          "light": "#C62828",
          "highContrast": "#FF6666",
          "highContrastLight": "#C62828"
        }
      },
      {
        "id": "howm.scheduleTodayForeground",
        "description": "%howm.scheduleTodayForeground.description%",
        "defaults": {
          "dark": "#FFD700",
          "light": "#806C00",
          "highContrast": "#FFD700",
          "highContrastLight": "#806C00"
        }
      }
    ],
    "commands": [
      {
        "command": "howm.home",
        "title": "%howm.home.title%"
      },
      {
        "command": "howm.create",
        "title": "%howm.create.title%",
        "icon": "$(new-file)"
      },
      {
        "command": "howm.openDailyMemo",
        "title": "%howm.openDailyMemo.title%",
        "shortTitle": "%howm.openDailyMemo.shortTitle%",
        "icon": "$(calendar)"
      },
      {
        "command": "howm.capture",
        "title": "%howm.capture.title%"
      },
      {
        "command": "howm.search",
        "title": "%howm.search.title%",
        "icon": "$(search)"
      },
      {
        "command": "howm.searchRegex",
        "title": "%howm.searchRegex.title%"
      },
      {
        "command": "howm.list",
        "title": "%howm.list.title%"
      },
      {
        "command": "howm.recent",
        "title": "%howm.recent.title%"
      },
      {
        "command": "howm.follow",
        "title": "%howm.follow.title%"
      },
      {
        "command": "howm.related",
        "title": "%howm.related.title%"
      },
      {
        "command": "howm.concatenate",
        "title": "%howm.concatenate.title%"
      },
      {
        "command": "howm.reminders",
        "title": "%howm.reminders.title%"
      },
      {
        "command": "howm.complete",
        "title": "%howm.complete.title%"
      },
      {
        "command": "howm.changeDate",
        "title": "%howm.changeDate.title%"
      },
      {
        "command": "howm.inputDate",
        "title": "%howm.inputDate.title%"
      },
      {
        "command": "howm.insertDate",
        "title": "%howm.insertDate.title%"
      },
      {
        "command": "howm.insertKeyword",
        "title": "%howm.insertKeyword.title%"
      },
      {
        "command": "howm.insertWindowsPathLink",
        "title": "%howm.insertWindowsPathLink.title%"
      },
      {
        "command": "howm.history",
        "title": "%howm.history.title%"
      },
      {
        "command": "howm.random",
        "title": "%howm.random.title%"
      },
      {
        "command": "howm.refresh",
        "title": "%howm.refresh.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "howm.configure",
        "title": "%howm.configure.title%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "howm.showTodos",
        "title": "%howm.showTodos.title%"
      },
      {
        "command": "howm.completeReminder",
        "title": "%howm.completeReminder.title%",
        "icon": "$(check)"
      },
      {
        "command": "howm.focusNotesSearch",
        "title": "%howm.focusNotesSearch.title%",
        "icon": "$(search)"
      },
      {
        "command": "howm.refreshOnThisDay",
        "title": "%howm.refreshOnThisDay.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "howm.refreshSimilarNotes",
        "title": "%howm.refreshSimilarNotes.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "howm.pinNote",
        "title": "%howm.pinNote.title%",
        "icon": {
          "light": "resources/pin-filled-light.svg",
          "dark": "resources/pin-filled-dark.svg"
        }
      },
      {
        "command": "howm.unpinNote",
        "title": "%howm.unpinNote.title%",
        "icon": {
          "light": "resources/pin-horizontal-light.svg",
          "dark": "resources/pin-horizontal-dark.svg"
        }
      },
      {
        "command": "howm.togglePin",
        "title": "%howm.togglePin.title%"
      },
      {
        "command": "howm.refreshRelatedPassages",
        "title": "%howm.refreshRelatedPassages.title%",
        "icon": "$(refresh)"
      }
    ],
    "keybindings": [
      {
        "command": "howm.create",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "howm.search",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h"
      }
    ],
    "views": {
      "howm": [
        {
          "id": "howm.calendar",
          "name": "%howm.calendar.title%",
          "type": "webview"
        },
        {
          "id": "howm.todos",
          "name": "%howm.todos.title%"
        },
        {
          "id": "howm.notes",
          "name": "%howm.notes.title%",
          "type": "webview"
        },
        {
          "id": "howm.onThisDay",
          "name": "%howm.onThisDay.title%",
          "visibility": "collapsed"
        },
        {
          "id": "howm.similarNotes",
          "name": "%howm.similarNotes.title%",
          "visibility": "collapsed",
          "type": "webview"
        },
        {
          "id": "howm.relatedPassages",
          "name": "%howm.relatedPassages.title%",
          "visibility": "collapsed",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "howm.create",
          "when": "view == howm.notes || view == howm.calendar",
          "group": "navigation@1"
        },
        {
          "command": "howm.openDailyMemo",
          "when": "view == howm.notes || view == howm.calendar",
          "group": "navigation@2"
        },
        {
          "command": "howm.focusNotesSearch",
          "when": "view == howm.notes",
          "group": "navigation@3"
        },
        {
          "command": "howm.refresh",
          "when": "view == howm.notes",
          "group": "navigation@4"
        },
        {
          "command": "howm.refresh",
          "when": "view == howm.todos",
          "group": "navigation@1"
        },
        {
          "command": "howm.configure",
          "when": "view == howm.todos",
          "group": "navigation@2"
        },
        {
          "command": "howm.refreshOnThisDay",
          "when": "view == howm.onThisDay",
          "group": "navigation@1"
        },
        {
          "command": "howm.refreshSimilarNotes",
          "when": "view == howm.similarNotes",
          "group": "navigation@1"
        },
        {
          "command": "howm.refreshRelatedPassages",
          "when": "view == howm.relatedPassages",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "howm.completeReminder",
          "when": "view == howm.todos && viewItem == howm.reminder",
          "group": "inline"
        },
        {
          "command": "howm.pinNote",
          "when": "view == howm.similarNotes && viewItem == howm.note",
          "group": "inline"
        },
        {
          "command": "howm.unpinNote",
          "when": "view == howm.similarNotes && viewItem == howm.pinnedNote",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "howm.completeReminder",
          "when": "false"
        },
        {
          "command": "howm.pinNote",
          "when": "false"
        },
        {
          "command": "howm.unpinNote",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "howm.pinNote",
          "when": "resource in howm.noteResources && resource not in howm.pinnedNoteResources",
          "group": "navigation@10"
        },
        {
          "command": "howm.unpinNote",
          "when": "resource in howm.noteResources && resource in howm.pinnedNoteResources",
          "group": "navigation@10"
        }
      ],
      "editor/context": [
        {
          "command": "howm.pinNote",
          "when": "resource in howm.noteResources && resource not in howm.pinnedNoteResources",
          "group": "howm@1"
        },
        {
          "command": "howm.unpinNote",
          "when": "resource in howm.noteResources && resource in howm.pinnedNoteResources",
          "group": "howm@1"
        }
      ]
    },
    "configuration": {
      "title": "%howm.configuration.title%",
      "properties": {
        "howm.autoLinkOnPaste": {
          "type": "boolean",
          "default": true,
          "description": "%howm.autoLinkOnPaste.description%"
        },
        "howm.notesDirectory": {
          "type": "string",
          "default": "",
          "description": "%howm.notesDirectory.description%"
        },
        "howm.filenamePattern": {
          "type": "string",
          "default": "{YYYY}/{MM}/{YYYY}-{MM}-{DD}-{HH}{mm}{ss}.md",
          "description": "%howm.filenamePattern.description%"
        },
        "howm.defaultTitle": {
          "type": "string",
          "default": "メモ",
          "description": "%howm.defaultTitle.description%"
        },
        "howm.template": {
          "type": "string",
          "default": "# {title}\n\n[{date} {time}]\n\n{body}\n",
          "description": "%howm.template.description%"
        },
        "howm.maxFileSizeKB": {
          "type": "number",
          "default": 1024,
          "minimum": 1,
          "description": "%howm.maxFileSizeKB.description%"
        },
        "howm.calendarWeekStart": {
          "type": "string",
          "enum": [
            "sunday",
            "monday"
          ],
          "enumDescriptions": [
            "%howm.calendarWeekStart.sunday.description%",
            "%howm.calendarWeekStart.monday.description%"
          ],
          "default": "sunday",
          "description": "%howm.calendarWeekStart.description%"
        },
        "howm.todos.dueSoonDays": {
          "type": "integer",
          "default": 3,
          "minimum": 0,
          "description": "%howm.todos.dueSoonDays.description%"
        },
        "howm.onThisDay.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%howm.onThisDay.enabled.description%"
        },
        "howm.similarNotes.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%howm.similarNotes.enabled.description%"
        },
        "howm.similarNotes.maxResults": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "description": "%howm.similarNotes.maxResults.description%"
        },
        "howm.similarNotes.minSimilarity": {
          "type": "number",
          "default": 0.1,
          "minimum": 0,
          "maximum": 1,
          "description": "%howm.similarNotes.minSimilarity.description%"
        },
        "howm.similarNotes.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "%howm.similarNotes.autoRefresh.description%"
        },
        "howm.relatedPassages.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%howm.relatedPassages.enabled.description%"
        },
        "howm.relatedPassages.maxResults": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "description": "%howm.relatedPassages.maxResults.description%"
        },
        "howm.relatedPassages.minSimilarity": {
          "type": "number",
          "default": 0.15,
          "minimum": 0,
          "maximum": 1,
          "description": "%howm.relatedPassages.minSimilarity.description%"
        },
        "howm.relatedPassages.contextLines": {
          "type": "integer",
          "default": 5,
          "minimum": 0,
          "description": "%howm.relatedPassages.contextLines.description%"
        },
        "howm.relatedPassages.windowLines": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "description": "%howm.relatedPassages.windowLines.description%"
        },
        "howm.relatedPassages.windowStep": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "description": "%howm.relatedPassages.windowStep.description%"
        },
        "howm.relatedPassages.minQueryLength": {
          "type": "integer",
          "default": 30,
          "minimum": 1,
          "description": "%howm.relatedPassages.minQueryLength.description%"
        },
        "howm.relatedPassages.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "%howm.relatedPassages.autoRefresh.description%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "howm",
          "title": "%howm.container.title%",
          "icon": "resources/howm.svg"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/vsce": "^3.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "htmlparser2": "^10.1.0",
    "ipaddr.js": "^2.5.0",
    "markdown-it": "^14.3.3"
  },
  "l10n": "./l10n"
}
